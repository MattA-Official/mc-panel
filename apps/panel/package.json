{
  "name": "@flytower/panel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun nuxt dev",
    "build": "bun --bun nuxt build",
    "preview": "bun .output/server/index.mjs",
    "postinstall": "bun --bun nuxt prepare",
    "typecheck": "bun --bun nuxt typecheck",
    "db:generate": "bunx --bun drizzle-kit generate && bun scripts/bundle-migrations.ts"
  },
  "dependencies": {
    "@flytower/protocol": "workspace:*",
    "@flytower/providers": "workspace:*",
    "@fontsource-variable/big-shoulders-display": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.152",
    "@nuxt/ui": "4.12.0",
    "@simplewebauthn/browser": "^13",
    "@simplewebauthn/server": "^13.3.2",
    "drizzle-orm": "0.45.4",
    "nuxt": "4.6.4",
    "nuxt-auth-utils": "0.6.2",
    "tailwindcss": "^4.3.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "vue-tsc": "^3.3.14"
  }
