{
  "name": "flytower",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "bun run --filter '*' typecheck && tsc -p tsconfig.scripts.json",
    "test": "bun test",
    "build": "bun run --filter '*' --filter '!@flytower/site' build",
    "build:site": "bun run --filter @flytower/site build",
    "package": "bun scripts/package.ts",
    "release-notes": "bun scripts/release-notes.ts",
    "docs:screens": "bun scripts/docs-screens.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
