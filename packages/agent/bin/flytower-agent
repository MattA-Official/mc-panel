#!/bin/sh
# Starts the Flytower agent. systemd runs this path rather than Bun itself, so a later
# release can put a different program here (docs/decisions/0001-rust-and-go.md).
#
# The Rust agent is the default. Put `bun` in $FLYTOWER_CONFIG_DIR/agent (normally
# /etc/flytower/agent) and restart flytower-agent to use the Bun one instead; delete the
# file to go back. The file outlives updates.
#
# If the Rust agent fails to start, this falls back to Bun by itself. Before starting it,
# this writes a marker beside the agent socket naming this release; the Rust agent deletes
# it once it is listening and has run its start-up steps. If the marker is still there when systemd restarts us, the last
# start failed, so we start Bun and leave the marker for the updater to see. /run is
# cleared at boot, and a new release has a different folder, so either one tries Rust again.
here=$(dirname "$(readlink -f "$0")")
choice=$(cat "${FLYTOWER_CONFIG_DIR:-/etc/flytower}/agent" 2>/dev/null)
socket=${FLYTOWER_AGENT_SOCKET:-/run/flytower/agent.sock}
marker=$(dirname "$socket")/agent-rust-starting
if [ "$choice" != bun ] && [ -x "$here/flytower-agent-rust" ]; then
  if [ "$(cat "$marker" 2>/dev/null)" = "$here" ]; then
    echo "flytower-agent: the Rust agent didn't start last time, so using the Bun agent." \
      "It tries Rust again after a reboot or an update, or now if you delete $marker" \
      "and restart flytower-agent." >&2
  else
    mkdir -p "$(dirname "$marker")" && printf '%s\n' "$here" >"$marker"
    exec "$here/flytower-agent-rust" "$@"
  fi
fi
exec "$here/bun" "$here/../agent/agent.js" "$@"
