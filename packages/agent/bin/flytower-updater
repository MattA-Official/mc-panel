#!/bin/sh
# Starts the Flytower updater: flytower-updater <version> [--manual]. The agent runs this
# path rather than Bun itself, so a later release can put a different program here
# (docs/decisions/0001-rust-and-go.md).
#
# Follows the same switch as bin/flytower-agent: the Rust updater unless $FLYTOWER_CONFIG_DIR/agent
# says `bun`. If the Rust agent fell back to Bun on this boot (its marker is still beside the
# socket), the updater uses Bun too: an update is the wrong time to try a Rust program that
# just failed here.
here=$(dirname "$(readlink -f "$0")")
choice=$(cat "${FLYTOWER_CONFIG_DIR:-/etc/flytower}/agent" 2>/dev/null)
socket=${FLYTOWER_AGENT_SOCKET:-/run/flytower/agent.sock}
marker=$(dirname "$socket")/agent-rust-starting
if [ "$choice" != bun ] && [ ! -e "$marker" ] && [ -x "$here/flytower-updater-rust" ]; then
  exec "$here/flytower-updater-rust" "$@"
fi
exec "$here/bun" "$here/../agent/updater.js" "$@"
